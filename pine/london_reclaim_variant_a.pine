//@version=6
// London Reclaim, breakout/swing port of examples/london_reclaim_full.json.
// Sweeps and their extremes exist only inside NY 09:30-11:00 and PM 13:30-15:30
// ET windows; raid state resets at each window start. Prior-day levels roll at
// 18:00 ET. All clocks use bar close, matching the engine's interval-end bars.
// TradingView fills can differ: its intrabar stop/target order has no engine OCO
// stop-first rule. Signal parity measured with the Python logic port in parity/.
strategy("London Reclaim - Variant A", overlay = true, initial_capital = 50000,
     default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0,
     calc_on_every_tick = false, commission_type = strategy.commission.cash_per_contract,
     commission_value = 0.37, slippage = 1)

TZ = "America/New_York"
if not (timeframe.isminutes and timeframe.multiplier == 1)
    runtime.error("London Reclaim requires a 1-minute chart")

// Engine round_to_tick uses half-even ties, including 3.5R targets.
roundTick(float price) =>
    ratio = price / syminfo.mintick
    lower = math.floor(ratio)
    fraction = ratio - lower
    rounded = fraction > 0.5 ? lower + 1 : fraction < 0.5 ? lower : lower % 2 == 0 ? lower : lower + 1
    rounded * syminfo.mintick

grpR = "Risk and targets"
swingBars = input.int(3, "Pullback swing bars per side", minval = 1, group = grpR)
maxSlPts = input.float(45.0, "Maximum stop distance, points", minval = 1, group = grpR)
tpRR = input.float(3.5, "Target, risk multiples", minval = 0.1, group = grpR)
maxWaitBars = input.int(12, "Maximum waiting bars", minval = 1, group = grpR)
maxTradesDay = input.int(4, "Maximum trades per day", minval = 1, group = grpR)
slOffTicks = input.float(1.0, "Stop offset, ticks", minval = 0, group = grpR)
riskUsd = input.float(100.0, "Risk per trade, USD", minval = 0, group = grpR)
maxContracts = input.int(10, "Maximum contracts", minval = 1, group = grpR)
grpL = "Levels"
useLondon = input.bool(true, "London high / low", group = grpL)
usePd = input.bool(true, "Prior-day high / low", group = grpL)
showLines = input.bool(true, "Show levels", group = grpL)
showZones = input.bool(true, "Shade windows", group = grpL)

// Databento timestamps are interval starts; engine advances them one minute.
etHour = hour(time_close, TZ)
etMinute = minute(time_close, TZ)
etClock = 60 * etHour + etMinute
inLondon = etClock >= 120 and etClock < 510
inNY = etClock >= 570 and etClock < 660
inPM = etClock >= 810 and etClock < 930
inFlat = etClock >= 955 and etClock < 965
inExec = inNY or inPM
newNY = inNY and not inNY[1]
newPM = inPM and not inPM[1]
calDay = year(time_close, TZ) * 10000 + month(time_close, TZ) * 100 + dayofmonth(time_close, TZ)
tdStamp = time_close + 6 * 60 * 60 * 1000
tdDay = year(tdStamp, TZ) * 10000 + month(tdStamp, TZ) * 100 + dayofmonth(tdStamp, TZ)
newCal = na(calDay[1]) or calDay != calDay[1]
newTd = na(tdDay[1]) or tdDay != tdDay[1]

var float tdHi = na
var float tdLo = na
var float pdh = na
var float pdl = na
if newTd
    pdh := tdHi
    pdl := tdLo
    tdHi := high
    tdLo := low
else
    tdHi := na(tdHi) ? high : math.max(tdHi, high)
    tdLo := na(tdLo) ? low : math.min(tdLo, low)

var float lonHi = na
var float lonLo = na
var bool lonLocked = false
if newCal
    lonHi := na
    lonLo := na
    lonLocked := false
if inLondon
    lonHi := na(lonHi) ? high : math.max(lonHi, high)
    lonLo := na(lonLo) ? low : math.min(lonLo, low)
if not inLondon and inLondon[1]
    lonLocked := true

// Engine fractals allow ties. Centre is swingBars bars old; latest confirmed wins.
var float lastSwLo = na
var float lastSwHi = na
var int lastSwLoBar = na
var int lastSwHiBar = na
if bar_index >= 2 * swingBars
    isLo = true
    isHi = true
    for j = 0 to 2 * swingBars
        if low[swingBars] > low[j]
            isLo := false
        if high[swingBars] < high[j]
            isHi := false
    if isLo
        lastSwLo := low[swingBars]
        lastSwLoBar := bar_index - swingBars
    if isHi
        lastSwHi := high[swingBars]
        lastSwHiBar := bar_index - swingBars

// London then prior-day. Traded flags persist across window resets.
var array<float> srcHi = array.new<float>(2, na)
var array<float> srcLo = array.new<float>(2, na)
var array<bool> srcOn = array.new<bool>(2, false)
var array<bool> sweptHi = array.new<bool>(2, false)
var array<bool> sweptLo = array.new<bool>(2, false)
var array<float> sweepHiPx = array.new<float>(2, na)
var array<float> sweepLoPx = array.new<float>(2, na)
var array<int> armLong = array.new<int>(2, na)
var array<int> armShort = array.new<int>(2, na)
var array<bool> tookLong = array.new<bool>(2, false)
var array<bool> tookShort = array.new<bool>(2, false)
var array<bool> brokenAm = array.new<bool>(2, false)
var int tradesToday = 0
var float pendEntry = na
var float pendStop = na
var float pendTgt = na
var int pendQty = na
var int pendBar = na
var int pendSrc = na
var bool pendLong = true
if newCal
    tradesToday := 0
    for i = 0 to 1
        array.set(srcOn, i, false)
        array.set(tookLong, i, false)
        array.set(tookShort, i, false)
        array.set(brokenAm, i, false)
        array.set(sweptHi, i, false)
        array.set(sweptLo, i, false)
        array.set(sweepHiPx, i, na)
        array.set(sweepLoPx, i, na)
        array.set(armLong, i, na)
        array.set(armShort, i, na)
if lonLocked and useLondon
    array.set(srcHi, 0, lonHi)
    array.set(srcLo, 0, lonLo)
    array.set(srcOn, 0, true)
if not na(pdh) and not na(pdl) and usePd
    array.set(srcHi, 1, pdh)
    array.set(srcLo, 1, pdl)
    array.set(srcOn, 1, true)
if not inNY and inNY[1]
    for i = 0 to 1
        array.set(brokenAm, i, array.get(sweptHi, i) or array.get(sweptLo, i))
if newNY or newPM
    for i = 0 to 1
        array.set(sweptHi, i, false)
        array.set(sweptLo, i, false)
        array.set(sweepHiPx, i, na)
        array.set(sweepLoPx, i, na)
        array.set(armLong, i, na)
        array.set(armShort, i, na)

// Only first sweep per source/window can cancel an already resting order.
cancelSweep = false
if inExec
    for i = 0 to 1
        if array.get(srcOn, i)
            hiLvl = array.get(srcHi, i)
            loLvl = array.get(srcLo, i)
            if low < loLvl
                if not array.get(sweptLo, i)
                    array.set(sweptLo, i, true)
                    array.set(armShort, i, bar_index)
                    if not na(pendEntry) and not pendLong and strategy.position_size == 0
                        cancelSweep := true
                px = array.get(sweepLoPx, i)
                array.set(sweepLoPx, i, na(px) ? low : math.min(px, low))
            if high > hiLvl
                if not array.get(sweptHi, i)
                    array.set(sweptHi, i, true)
                    array.set(armLong, i, bar_index)
                    if not na(pendEntry) and pendLong and strategy.position_size == 0
                        cancelSweep := true
                px = array.get(sweepHiPx, i)
                array.set(sweepHiPx, i, na(px) ? high : math.max(px, high))

justFilled = strategy.position_size != 0 and strategy.position_size[1] == 0
wentFlat = strategy.position_size == 0 and strategy.position_size[1] != 0
if justFilled
    tradesToday += 1
    if not na(pendSrc)
        if pendLong
            array.set(tookLong, pendSrc, true)
        else
            array.set(tookShort, pendSrc, true)
if wentFlat
    pendEntry := na
    pendStop := na
    pendTgt := na
    pendQty := na
    pendBar := na
    pendSrc := na

// Placement bar has age zero. Bar maxWaitBars+1 may fill, then cancels at close.
expired = not na(pendBar) and bar_index - pendBar > maxWaitBars
if not na(pendEntry) and strategy.position_size == 0 and (cancelSweep or expired or not inExec)
    strategy.cancel("L")
    strategy.cancel("S")
    pendEntry := na
    pendStop := na
    pendTgt := na
    pendQty := na
    pendBar := na
    pendSrc := na

if inExec and strategy.position_size == 0 and na(pendEntry) and tradesToday < maxTradesDay
    for i = 0 to 1
        if na(pendEntry) and array.get(srcOn, i) and not (inPM and array.get(brokenAm, i))
            aL = array.get(armLong, i)
            if not array.get(tookLong, i) and not na(aL) and not na(lastSwLoBar) and lastSwLoBar >= aL
                ext = array.get(sweepHiPx, i)
                e = roundTick(ext + syminfo.mintick)
                s = roundTick(lastSwLo - slOffTicks * syminfo.mintick)
                risk = e - s
                qty = risk > 0 ? int(math.floor(riskUsd / (risk * syminfo.pointvalue))) : 0
                if e > close and risk > 0 and risk <= maxSlPts and qty >= 1
                    pendEntry := e
                    pendStop := s
                    pendTgt := roundTick(e + tpRR * risk)
                    pendQty := math.min(qty, maxContracts)
                    pendBar := bar_index
                    pendSrc := i
                    pendLong := true
            aS = array.get(armShort, i)
            if na(pendEntry) and not array.get(tookShort, i) and not na(aS) and not na(lastSwHiBar) and lastSwHiBar >= aS
                ext = array.get(sweepLoPx, i)
                e = roundTick(ext - syminfo.mintick)
                s = roundTick(lastSwHi + slOffTicks * syminfo.mintick)
                risk = s - e
                qty = risk > 0 ? int(math.floor(riskUsd / (risk * syminfo.pointvalue))) : 0
                if e < close and risk > 0 and risk <= maxSlPts and qty >= 1
                    pendEntry := e
                    pendStop := s
                    pendTgt := roundTick(e - tpRR * risk)
                    pendQty := math.min(qty, maxContracts)
                    pendBar := bar_index
                    pendSrc := i
                    pendLong := false
if not na(pendEntry) and strategy.position_size == 0
    if pendLong
        strategy.entry("L", strategy.long, qty = pendQty, stop = pendEntry)
    else
        strategy.entry("S", strategy.short, qty = pendQty, stop = pendEntry)
if strategy.position_size > 0
    strategy.exit("xL", from_entry = "L", stop = pendStop, limit = pendTgt)
if strategy.position_size < 0
    strategy.exit("xS", from_entry = "S", stop = pendStop, limit = pendTgt)
if inFlat and strategy.position_size != 0
    strategy.cancel("xL")
    strategy.cancel("xS")
    strategy.close_all(comment = "EOD flat")

plot(showLines and array.get(srcOn, 0) ? array.get(srcHi, 0) : na, "London high", color.orange)
plot(showLines and array.get(srcOn, 0) ? array.get(srcLo, 0) : na, "London low", color.orange)
plot(showLines and array.get(srcOn, 1) ? array.get(srcHi, 1) : na, "Prior-day high", color.blue)
plot(showLines and array.get(srcOn, 1) ? array.get(srcLo, 1) : na, "Prior-day low", color.blue)
bgcolor(showZones ? inLondon ? color.new(color.orange, 94) : inNY ? color.new(color.teal, 94) : inPM ? color.new(color.purple, 94) : na : na)
plotshape(justFilled and strategy.position_size > 0, "BUY", shape.labelup, location.belowbar, color.teal, text = "BUY", textcolor = color.white)
plotshape(justFilled and strategy.position_size < 0, "SELL", shape.labeldown, location.abovebar, color.red, text = "SELL", textcolor = color.white)
alertcondition(justFilled and strategy.position_size > 0, "Variant A BUY", "London Reclaim: BUY signal")
alertcondition(justFilled and strategy.position_size < 0, "Variant A SELL", "London Reclaim: SELL signal")
